# Reference only: the launchers do not source .env. Never commit local secrets.
# In the canonical fork layout these are inferred as <fork>/examples/anysearch
# and <fork>; leave them unset unless a wrapper needs explicit absolute paths.
ANYSEARCH_ROOT=
SLIME_ROOT=
MEGATRON_ROOT=/path/to/Megatron-LM

# Hugging Face and Megatron distributed checkpoints for the selected backbone.
HF_CHECKPOINT=/path/to/hf-checkpoint
REF_LOAD=/path/to/torch-dist-reference-checkpoint
LOAD_CHECKPOINT=
SAVE_CHECKPOINT=/path/to/output/checkpoint

# Canonical Parquet produced by scripts/prepare_data.py.
TRAIN_DATA=/path/to/data/train/nq_hotpotqa_train.parquet
EVAL_DATA_DIR=/path/to/data/eval
# Set an immutable Hugging Face commit when downloading FlashRAG data; leaving
# this blank uses the current tip.
FLASHRAG_REVISION=

# Local E5 + FAISS service.
RETRIEVER_URL=http://127.0.0.1:8000/retrieve
# Fail-fast launcher preflight timeout; dry runs never contact the service.
ANYSEARCH_RETRIEVAL_HEALTH_TIMEOUT=10
RETRIEVER_INDEX=/path/to/e5_Flat.index
RETRIEVER_CORPUS=/path/to/wiki-18.jsonl
RETRIEVER_MODEL=intfloat/e5-base-v2
# CPU-safe default; set to 1 with a CUDA-compatible FAISS installation.
RETRIEVER_FAISS_GPU=0
RETRIEVER_CUDA_VISIBLE_DEVICES=4,5,6,7
ROLLOUT_MAX_CONTEXT_LEN=32768

# Ray. START_RAY=1 starts a new local head only when the configured address is not healthy.
MASTER_ADDR=127.0.0.1
RAY_DASHBOARD_ADDRESS=http://127.0.0.1:8265
START_RAY=0
CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7

# Optional experiment tracking and evaluation output.
WANDB_API_KEY=
WANDB_PROJECT=anysearch
ANYSEARCH_EVAL_OUTPUT_DIR=/path/to/results
TRAIN_SEED=42
EVAL_SEED=42
